rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Apenas usuários autenticados têm acesso aos dados da clínica
    match /clinica/{document} {
      allow read, write: if request.auth != null;
    }

    // Coleções compartilhadas entre o Gestão e o Prontuário (mesmo projeto Firebase).
    // Pacientes e atendimentos migraram do formato "array em 1 doc" para documentos
    // individuais, para permitir escrita concorrente das duas aplicações.
    match /pacientes/{pacienteId} {
      allow read, write: if request.auth != null;
    }
    match /atendimentos/{atendimentoId} {
      allow read, write: if request.auth != null;
    }
  }
}
