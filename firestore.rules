rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Apenas usuários autenticados têm acesso aos dados da clínica
    match /clinica/{document} {
      allow read, write: if request.auth != null;
    }

    // Coleções compartilhadas entre o Gestão e o Prontuário (mesmo projeto Firebase).
    // Pacientes e atendimentos migraram do formato "array em 1 doc" para documentos
    // individuais, para permitir escrita concorrente das duas aplicações.
    match /{collection}/{documentId} {
      allow read, write: if request.auth != null && (
        collection == 'clinica' ||
        collection == 'pacientes' ||
        collection == 'atendimentos' ||
        collection == 'profissionais' ||
        collection == 'despesas' ||
        collection == 'cobrancas' ||
        collection == 'cobrancas_excluidas' ||
        collection == 'receitas' ||
        collection == 'custom_subcats' ||
        collection == 'custom_rec_cats' ||
        collection == 'reservas_auditorio'
      );
    }
  }
}
